// Imported by `zbx import` from Dockerfile: target build, --network detect.
// Edit this file from here on: `zbx build` reads it, not the Dockerfile.
.{
    .version = 1,
    .steps = .{
        // Dockerfile:4  COPY go.mod go.sum ./
        .{
            .name = "deps-1",
            .base = "golang:1.22",
            .copy = .{
                .{ .src = .{ "go.mod", "go.sum" }, .to = "/src/" },
            },
        },
        // Dockerfile:5  RUN --mount=type=cache,target=/go/pkg/mod go mod download
        .{
            .name = "deps-2",
            .base = "step:deps-1",
            .run = .{ "/bin/sh", "-c", "go mod download" },
            .network = true,
            .output = .root,
            .workdir = "/src",
            .caches = .{
                .{ .id = "/go/pkg/mod", .path = "/go/pkg/mod" },
            },
        },
        // Dockerfile:8  RUN --mount=type=cache,id=gomod,target=/go/pkg/mod,sharing=shared     --mount=t...
        .{
            .name = "build-1",
            .base = "golang:1.22",
            .run = .{ "/bin/sh", "-c", "go build -o /out/rclone ." },
            .output = .root,
            .workdir = "/src",
            .caches = .{
                .{ .id = "gomod", .path = "/go/pkg/mod" },
                .{ .id = "/root/.cache/go-build", .path = "/root/.cache/go-build" },
            },
            .binds = .{
                .{ .from = "step:deps-2", .source = "/src", .to = "/src" },
            },
        },
    },
    .image = .{
        .base = "step:build-1",
        .config = .{
            .workdir = "/src",
        },
    },
}
