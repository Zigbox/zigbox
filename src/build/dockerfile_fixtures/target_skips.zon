// Imported by `zbx import` from Dockerfile: target app, --network detect.
// Edit this file from here on: `zbx build` reads it, not the Dockerfile.
.{
    .version = 1,
    .steps = .{
        // Dockerfile:3  RUN echo app > /app
        .{
            .name = "app-1",
            .base = "alpine:3.20",
            .run = .{ "/bin/sh", "-c", "echo app > /app" },
            .output = .root,
        },
    },
    .image = .{
        .base = "step:app-1",
    },
}
