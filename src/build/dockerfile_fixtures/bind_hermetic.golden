// Imported by `zbx import` from Dockerfile: target stage1, --network detect.
// Edit this file from here on: `zbx build` reads it, not the Dockerfile.
.{
    .version = 1,
    .steps = .{
        // Dockerfile:3  RUN echo built > /out.txt
        .{
            .name = "build-1",
            .base = "alpine:3.20",
            .run = .{ "/bin/sh", "-c", "echo built > /out.txt" },
            .output = .root,
        },
        // Dockerfile:5  RUN --mount=type=bind,from=build,target=/mnt cp /mnt/out.txt /copy.txt
        .{
            .name = "stage1-1",
            .base = "alpine:3.20",
            .run = .{ "/bin/sh", "-c", "cp /mnt/out.txt /copy.txt" },
            .output = .root,
            .binds = .{
                .{ .from = "step:build-1", .source = "/", .to = "/mnt" },
            },
        },
    },
    .image = .{
        .base = "step:stage1-1",
    },
}
